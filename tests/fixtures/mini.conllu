# ============================================================================
# mini.conllu -- hand-verified fixture for the dependency-length pipeline.
#
# Purpose: make the entire test suite and a full `python main.py --fixture`
# run work with ZERO network access. Several sentences are constructed to
# exercise exactly the cases that silently corrupt DL code:
#   * multiword token ranges (1-2)
#   * empty nodes (3.1)
#   * non-projective arcs
#   * trees that must be REJECTED (cycle, two roots, out-of-range head)
#
# DL values for the sentences marked "HAND-VERIFIED" are worked out in the
# comment above each one, using 0-based indices after MWT/empty-node removal.
# ============================================================================

# --- English -----------------------------------------------------------------
# HAND-VERIFIED  s-en-1  "the dog chased the cat"
# 0-based: 0 the, 1 dog, 2 chased, 3 the, 4 cat
# heads:   0->1, 1->2, 2->ROOT, 3->4, 4->2
# word_dl: |1-0|=1, |2-1|=1, |4-3|=1, |2-4|=2          -> sum 5
# is_head (global): 1 (heads 0), 2 (heads 1,4), 4 (heads 3)  -> {1,2,4}
# head_dl per arc (strictly inside span):
#   (1,0) span(0,1) inside {}      -> 0
#   (2,1) span(1,2) inside {}      -> 0
#   (4,3) span(3,4) inside {}      -> 0
#   (2,4) span(2,4) inside {3}     -> 3 is not a head -> 0
# head_dl sum = 0
# sent_id = s-en-1
# text = the dog chased the cat
1	the	the	DET	DT	_	2	det	_	_
2	dog	dog	NOUN	NN	_	3	nsubj	_	_
3	chased	chase	VERB	VBD	_	0	root	_	_
4	the	the	DET	DT	_	5	det	_	_
5	cat	cat	NOUN	NN	_	3	obj	_	_

# HAND-VERIFIED  s-en-2  "a very old man slept"
# 0-based: 0 a, 1 very, 2 old, 3 man, 4 slept
# heads:   0->3, 1->2, 2->3, 3->4, 4->ROOT
# word_dl: |3-0|=3, |2-1|=1, |3-2|=1, |4-3|=1          -> sum 6
# is_head (global): {2 (heads 1), 3 (heads 0,2), 4 (heads 3)}
# head_dl:
#   (3,0) span(0,3) inside {1,2}: 1 no, 2 yes          -> 1
#   (2,1) span(1,2) inside {}                          -> 0
#   (3,2) span(2,3) inside {}                          -> 0
#   (4,3) span(3,4) inside {}                          -> 0
# head_dl sum = 1
# sent_id = s-en-2
# text = a very old man slept
1	a	a	DET	DT	_	4	det	_	_
2	very	very	ADV	RB	_	3	advmod	_	_
3	old	old	ADJ	JJ	_	4	amod	_	_
4	man	man	NOUN	NN	_	5	nsubj	_	_
5	slept	sleep	VERB	VBD	_	0	root	_	_

# s-en-3  non-projective: "a man came who smiled"
# The relative clause attaches to "man" (index 1) but sits after "came",
# so arc (1 -> 4) crosses arc (2 -> 1). Used to test is_projective().
# sent_id = s-en-3
# text = a man came who smiled
1	a	a	DET	DT	_	2	det	_	_
2	man	man	NOUN	NN	_	3	nsubj	_	_
3	came	come	VERB	VBD	_	0	root	_	_
4	who	who	PRON	WP	_	5	nsubj	_	_
5	smiled	smile	VERB	VBD	_	2	acl:relcl	_	_

# s-en-4  contains an EMPTY NODE (5.1) from an elided verb.
# After dropping 5.1 there are 5 real tokens; heads must still resolve.
# sent_id = s-en-4
# text = Mary ate rice and John beans
1	Mary	Mary	PROPN	NNP	_	2	nsubj	_	_
2	ate	eat	VERB	VBD	_	0	root	_	_
3	rice	rice	NOUN	NN	_	2	obj	_	_
4	and	and	CCONJ	CC	_	5	cc	_	_
5	John	John	PROPN	NNP	_	2	conj	_	_
5.1	ate	eat	VERB	VBD	_	_	_	_	_
6	beans	bean	NOUN	NN	_	5	orphan	_	_

# --- Spanish (multiword tokens: "del" = de + el, "al" = a + el) ---------------
# HAND-VERIFIED  s-es-1  "vi al perro del vecino"
# CoNLL-U has MWT ranges 2-3 (al) and 5-6 (del) which MUST be dropped.
# Real tokens 0-based: 0 vi, 1 a, 2 el, 3 perro, 4 de, 5 el, 6 vecino
# heads:  0->ROOT, 1->3, 2->3, 3->0, 4->6, 5->6, 6->3
# word_dl: |3-1|=2, |3-2|=1, |0-3|=3, |6-4|=2, |6-5|=1, |3-6|=3   -> sum 12
# is_head (global): {0 (heads 3), 3 (heads 1,2,6), 6 (heads 4,5)}
# head_dl:
#   (3,1) span(1,3) inside {2}: no    -> 0
#   (3,2) span(2,3) inside {}         -> 0
#   (0,3) span(0,3) inside {1,2}: no  -> 0
#   (6,4) span(4,6) inside {5}: no    -> 0
#   (6,5) span(5,6) inside {}         -> 0
#   (3,6) span(3,6) inside {4,5}: no  -> 0
# head_dl sum = 0
# sent_id = s-es-1
# text = vi al perro del vecino
1	vi	ver	VERB	_	_	0	root	_	_
2-3	al	_	_	_	_	_	_	_	_
2	a	a	ADP	_	_	4	case	_	_
3	el	el	DET	_	_	4	det	_	_
4	perro	perro	NOUN	_	_	1	obj	_	_
5-6	del	_	_	_	_	_	_	_	_
5	de	de	ADP	_	_	7	case	_	_
6	el	el	DET	_	_	7	det	_	_
7	vecino	vecino	NOUN	_	_	4	nmod	_	_

