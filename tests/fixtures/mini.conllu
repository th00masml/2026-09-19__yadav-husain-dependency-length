# --- Sentences that MUST be rejected by validate() ----------------------------

# REJECT: no root at all -- every token points at another token.
# sent_id = s-bad-noroot
1	a	a	DET	_	_	2	det	_	_
2	b	b	NOUN	_	_	3	nsubj	_	_
3	c	c	VERB	_	_	2	ccomp	_	_

# REJECT: cycle. Token 1 is a legitimate root, but tokens 3 and 4 point at each
# other, forming a component detached from the root. This has exactly ONE root,
# so it gets past the root checks and must be caught by cycle detection itself.
# sent_id = s-bad-cycle
1	a	a	VERB	_	_	0	root	_	_
2	b	b	NOUN	_	_	1	nsubj	_	_
3	c	c	NOUN	_	_	4	nmod	_	_
4	d	d	NOUN	_	_	3	nmod	_	_

# REJECT: two roots
# sent_id = s-bad-two-roots
1	a	a	DET	_	_	0	root	_	_
2	b	b	NOUN	_	_	0	root	_	_
3	c	c	VERB	_	_	1	dep	_	_

# REJECT: head index out of range (points at token 9 in a 3-token sentence)
# sent_id = s-bad-range
1	a	a	DET	_	_	9	det	_	_
2	b	b	NOUN	_	_	3	nsubj	_	_
3	c	c	VERB	_	_	0	root	_	_

# REJECT: too short (< min_tokens = 3)
# sent_id = s-bad-short
1	hi	hi	INTJ	_	_	0	root	_	_

