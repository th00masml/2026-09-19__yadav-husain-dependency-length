# is_head (global): {0 (heads 1), 2 (heads 3), 4 (heads 0,2)}
# head_dl:
#   (4,0) span(0,4) inside {1,2,3}: 2 is a head        -> 1
#   (0,1) span(0,1) inside {}                          -> 0
#   (4,2) span(2,4) inside {3}: no                     -> 0
#   (2,3) span(2,3) inside {}                          -> 0
# head_dl sum = 1
