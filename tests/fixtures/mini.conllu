1	el	el	DET	_	_	2	det	_	_
2	nino	nino	NOUN	_	_	6	nsubj	_	_
3-4	del	_	_	_	_	_	_	_	_
3	de	de	ADP	_	_	5	case	_	_
4	el	el	DET	_	_	5	det	_	_
5	pueblo	pueblo	NOUN	_	_	2	nmod	_	_
6	leyo	leer	VERB	_	_	0	root	_	_
7	un	uno	DET	_	_	8	det	_	_
8	libro	libro	NOUN	_	_	6	obj	_	_
9	nuevo	nuevo	ADJ	_	_	8	amod	_	_

# --- Japanese (head-final; a useful contrast for the head-count metric) -------
